# Environment Variables for Fennec Do Backend

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# CORS Origin (comma-separated for multiple origins)
# In development: http://localhost:5173
# In production: https://your-webapp-domain.com
CORS_ORIGIN=*

# Database Path (optional, defaults to ./fennec-do.db)
# For Docker/persistent volumes, you might want: /data/fennec-do.db
DB_PATH=./fennec-do.db
